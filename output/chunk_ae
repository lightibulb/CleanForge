enum class UnavailableReason {
    NOT_INSTALLED,
    NOT_RUNNING,
    NEEDS_PERMISSION,
    PERMISSION_PERMANENTLY_DENIED,
    SERVER_TOO_OLD,
    SHIZUKU_ERROR,
    BIND_FAILED,
