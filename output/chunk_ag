        targetValue = if (checked) 1f else 0f,
        animationSpec = tween(300), label = "tick",
    )

    Box(
        modifier = modifier
            .size(22.dp)
            .graphicsLayer { scaleX = scale; scaleY = scale }
            .clip(RoundedCornerShape(7.dp))
            .background(bg)
            .border(1.5.dp, borderColor, RoundedCornerShape(7.dp)),
