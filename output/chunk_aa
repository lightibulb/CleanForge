<script>
/* ─────────────────────────────────────────────
   Haptics — graceful on unsupported devices
   ───────────────────────────────────────────── */
function haptic(pattern = 'light') {
  if (!('vibrate' in navigator)) return;
  const P = {
    light: 8,
    medium: 14,
    heavy: 24,
    tick: 5,
    success: [10, 40, 18],
    warn:    [16, 55, 16],
    error:   [26, 45, 26, 45, 26],
  };
  try { navigator.vibrate(P[pattern] ?? pattern); } catch (_) {}
}

/* ─────────────────────────────────────────────
   Toast
