      --surface-dim: #D7DBD3;
      --surface-bright: #F6FBF3;
      --inverse-surface: #2D322D;
      --inverse-on-surface: #EDF2EA;
      --shadow: rgba(0,0,0,0.12);
      --font: 'Roboto', system-ui, -apple-system, sans-serif;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 28px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: var(--font);
      background: var(--background);
      color: var(--on-background);
      display: flex;
      justify-content: center;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── App Shell ── */
    .app {
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--background);
      position: relative;
      overflow: hidden;
    }

    /* ── Top App Bar ── */
    .top-bar {
      padding: 16px 16px 12px;
      background: var(--surface);
      position: sticky;
      top: 0;
      z-index: 10;
      transition: padding 0.2s;
    }
    .top-bar h1 {
      font-size: 28px;
      font-weight: 400;
      color: var(--on-surface);
      letter-spacing: 0;
      line-height: 1.2;
    }
    .top-bar.scrolled {
      padding: 8px 16px;
    }
    .top-bar.scrolled h1 {
      font-size: 22px;
    }

    /* ── Content Area ── */
    .content {
      flex: 1;
      overflow-y: auto;
      padding: 0 0 120px 0;
      scroll-behavior: smooth;
    }
    .screen {
      display: none;
      animation: fadeIn 0.2s ease;
    }
    .screen.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Cards ── */
    .card {
      background: var(--surface-container-high);
      border-radius: var(--radius-lg);
      margin: 8px 16px;
      padding: 16px;
      box-shadow: 0 1px 2px var(--shadow);
    }
    .card-primary {
      background: var(--primary-container);
      color: var(--on-primary-container);
    }
    .card-tertiary {
      background: var(--tertiary-container);
      color: var(--on-tertiary-container);
    }

    /* ── Storage Hero ── */
    .hero {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 20px;
    }
    .hero-ring {
      position: relative;
      width: 96px;
      height: 96px;
      flex-shrink: 0;
    }
    .hero-ring svg {
      width: 96px;
      height: 96px;
      transform: rotate(-90deg);
    }
    .hero-ring .pct {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 600;
      color: var(--on-primary-container);
    }
    .hero-info h2 {
      font-size: 28px;
      font-weight: 600;
      line-height: 1.2;
    }
    .hero-info p {
      font-size: 16px;
      opacity: 0.85;
      margin-top: 2px;
    }

    /* ── Info Card ── */
    .info-card {
      background: var(--surface-container-high);
      border-radius: var(--radius-lg);
      margin: 6px 16px;
      padding: 16px;
    }
    .info-card .header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }
    .info-card .header .icon {
      font-size: 24px;
      width: 32px;
      text-align: center;
    }
    .info-card .header h3 {
      font-size: 16px;
      font-weight: 600;
    }
    .info-card p {
      font-size: 14px;
      color: var(--on-surface-variant);
      line-height: 1.5;
      margin-bottom: 12px;
    }
    .info-card .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 20px;
      border-radius: var(--radius-xl);
      border: none;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.15s;
      letter-spacing: 0.02em;
    }
    .btn-filled {
      background: var(--primary);
      color: var(--on-primary);
    }
    .btn-filled:hover { opacity: 0.9; }
    .btn-tonal {
      background: var(--secondary-container);
      color: var(--on-secondary-container);
    }
    .btn-tonal:hover { opacity: 0.9; }
    .btn-outlined {
      background: transparent;
      color: var(--primary);
      border: 1px solid var(--outline);
    }
    .btn-outlined:hover { background: rgba(0,109,59,0.06); }
    .btn-text {
      background: transparent;
      color: var(--primary);
      padding: 8px 12px;
    }
    .btn-text:hover { background: rgba(0,109,59,0.06); }
    .btn-error {
      background: transparent;
      color: var(--error);
    }
    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .btn-sm {
      padding: 8px 16px;
      font-size: 13px;
    }

    /* ── Scan Bar ── */
    .scan-bar {
      background: var(--surface-container-highest);
      border-radius: var(--radius-lg);
      margin: 8px 16px;
      padding: 16px;
    }
    .scan-bar .label {
      font-size: 14px;
      color: var(--on-surface-variant);
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .scan-bar .actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    /* ── Notice Card ── */
    .notice-card {
      background: var(--error-container);
      color: var(--on-error-container);
      border-radius: var(--radius-lg);
      margin: 8px 16px;
      padding: 16px;
      font-size: 14px;
      line-height: 1.5;
    }

    /* ── Results ── */
    .category-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 16px 4px;
    }
    .category-header .name {
      font-size: 14px;
      font-weight: 600;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .category-header .count {
      font-size: 12px;
      color: var(--on-surface-variant);
    }

    .item-row {
      display: flex;
      align-items: flex-start;
      padding: 12px 16px;
      gap: 12px;
      cursor: pointer;
      transition: background 0.1s;
      border-bottom: 1px solid var(--outline-variant);
    }
    .item-row:hover {
      background: rgba(0,0,0,0.02);
    }
    .item-row .check {
      width: 20px;
      height: 20px;
      border: 2px solid var(--outline);
      border-radius: 4px;
      flex-shrink: 0;
      margin-top: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.15s;
      background: transparent;
    }
    .item-row .check.checked {
      background: var(--primary);
      border-color: var(--primary);
    }
    .item-row .check.checked::after {
      content: '✓';
      color: white;
      font-size: 14px;
      font-weight: 700;
    }
    .item-row .body {
      flex: 1;
      min-width: 0;
    }
    .item-row .name {
      font-size: 15px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .item-row .reason {
      font-size: 12px;
      color: var(--on-surface-variant);
      margin-top: 2px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      line-height: 1.4;
    }
    .item-row .path {
      font-size: 11px;
      color: var(--on-surface-variant);
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: monospace;
    }
    .item-row .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 6px;
    }
    .tag {
      font-size: 10px;
      padding: 2px 8px;
      border-radius: var(--radius-sm);
      font-weight: 500;
      white-space: nowrap;
    }
    .tag-safe { background: var(--primary-container); color: var(--on-primary-container); }
    .tag-check { background: var(--tertiary-container); color: var(--on-tertiary-container); }
    .tag-danger { background: var(--error-container); color: var(--on-error-container); }
    .tag-neutral { background: var(--surface-variant); color: var(--on-surface-variant); }
    .item-row .size {
      font-size: 13px;
      font-weight: 600;
      color: var(--on-surface);
      flex-shrink: 0;
      margin-top: 2px;
    }

    /* ── Empty State ── */
    .empty-state {
      text-align: center;
      padding: 48px 24px;
      color: var(--on-surface-variant);
      font-size: 14px;
      line-height: 1.6;
    }

    /* ── RAM Screen ── */
    .ram-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px 16px;
      gap: 16px;
    }
    .ram-gauge {
      position: relative;
      width: 160px;
      height: 160px;
    }
    .ram-gauge svg {
      width: 160px;
      height: 160px;
      transform: rotate(-90deg);
    }
    .ram-gauge .label {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .ram-gauge .label .pct {
      font-size: 28px;
      font-weight: 700;
      color: var(--on-surface);
    }
    .ram-gauge .label .sub {
      font-size: 12px;
      color: var(--on-surface-variant);
      margin-top: 2px;
    }
    .ram-stats {
      text-align: center;
    }
    .ram-stats .used {
      font-size: 18px;
      font-weight: 600;
    }
    .ram-stats .avail {
      font-size: 14px;
      color: var(--on-surface-variant);
      margin-top: 4px;
    }
    .ram-explainer {
      background: var(--surface-container-high);
      border-radius: var(--radius-lg);
      padding: 16px;
      margin: 0 16px;
      font-size: 13px;
      line-height: 1.6;
      color: var(--on-surface-variant);
      width: 100%;
    }
    .ram-explainer strong {
      color: var(--on-surface);
    }

    /* ── About Screen ── */
    .about-header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 20px;
    }
    .about-icon {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      flex-shrink: 0;
    }
    .about-header h2 {
      font-size: 22px;
      font-weight: 600;
    }
    .about-header .sub {
      font-size: 15px;
      margin-top: 2px;
    }
    .about-header .meta {
      font-size: 12px;
      opacity: 0.7;
      margin-top: 2px;
    }
    .fact-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--outline-variant);
    }
    .fact-row:last-child {
      border-bottom: none;
    }
    .fact-row .icon {
      font-size: 22px;
      width: 32px;
      text-align: center;
      flex-shrink: 0;
    }
    .fact-row .text {
      flex: 1;
    }
    .fact-row .text h4 {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .fact-row .text p {
      font-size: 13px;
      color: var(--on-surface-variant);
      line-height: 1.5;
    }

    /* ── Bottom Navigation ── */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      background: var(--surface-container);
      display: flex;
      justify-content: space-around;
      padding: 8px 0 12px;
      border-top: 1px solid var(--outline-variant);
      z-index: 20;
      box-shadow: 0 -2px 8px rgba(0,0,0,0.06);
    }
    .nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 4px 12px;
      border-radius: var(--radius-xl);
      cursor: pointer;
      transition: 0.15s;
      border: none;
      background: transparent;
      font-family: var(--font);
      color: var(--on-surface-variant);
      min-width: 64px;
    }
    .nav-item.active {
      color: var(--on-secondary-container);
      background: var(--secondary-container);
    }
    .nav-item .icon {
      font-size: 22px;
      line-height: 1;
    }
    .nav-item .label {
      font-size: 11px;
      font-weight: 500;
    }

    /* ── FAB ── */
    .fab {
      position: fixed;
      bottom: 90px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary);
      color: var(--on-primary);
      border: none;
      border-radius: var(--radius-xl);
      padding: 14px 24px;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(0,109,59,0.3);
      z-index: 15;
      transition: 0.2s;
      animation: fabIn 0.2s ease;
    }
    .fab:hover { opacity: 0.92; }
    .fab.hidden { display: none; }
    @keyframes fabIn {
      from { opacity: 0; transform: translateX(-50%) translateY(8px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    /* ── Dialogs ── */
    .dialog-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 24px;
      animation: fadeIn 0.15s;
    }
    .dialog-overlay.hidden { display: none; }
    .dialog {
      background: var(--surface-container-high);
      border-radius: var(--radius-xl);
      padding: 24px;
      width: 100%;
      max-width: 400px;
      max-height: 80vh;
      overflow-y: auto;
      animation: dialogIn 0.2s ease;
    }
    @keyframes dialogIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .dialog h2 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 16px;
    }
    .dialog .dialog-body {
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 20px;
    }
    .dialog .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
    .dialog .evidence-item {
      padding: 8px 0;
      border-bottom: 1px solid var(--outline-variant);
      font-size: 13px;
    }
    .dialog .evidence-item .path {
      font-weight: 600;
      font-family: monospace;
      font-size: 12px;
      word-break: break-all;
    }
    .dialog .evidence-item .detail {
      color: var(--on-surface-variant);
      font-size: 12px;
      margin-top: 2px;
    }
    .progress-bar {
      width: 100%;
      height: 4px;
      background: var(--surface-variant);
      border-radius: 2px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .progress-bar .fill {
      height: 100%;
      background: var(--primary);
      border-radius: 2px;
      transition: width 0.3s;
    }

    /* ── Scrollbar ── */
    .content::-webkit-scrollbar { width: 4px; }
    .content::-webkit-scrollbar-thumb { background: var(--outline-variant); border-radius: 2px; }
  </style>
</head>
<body>
  <div class="app" id="app">
    <!-- Top App Bar -->
    <div class="top-bar" id="topBar">
      <h1 id="topTitle">CleanForge</h1>
    </div>

    <!-- Content -->
    <div class="content" id="content">
      <!-- Clean Screen -->
      <div class="screen active" id="screen-clean">
        <!-- Storage Hero -->
        <div class="card card-primary hero" id="storageHero">
          <div class="hero-ring">
            <svg viewBox="0 0 96 96">
              <circle cx="48" cy="48" r="42" fill="none" stroke="var(--surface-container-highest)" stroke-width="9"/>
              <circle cx="48" cy="48" r="42" fill="none" stroke="var(--primary)" stroke-width="9"
                stroke-dasharray="264" stroke-dashoffset="132" stroke-linecap="round" id="heroRing"/>
            </svg>
            <div class="pct" id="heroPct">50%</div>
          </div>
          <div class="hero-info">
            <h2 id="heroFree">12.4 GB</h2>
            <p id="heroTotal">free of 64 GB</p>
          </div>
        </div>

        <!-- All Files Access Card -->
        <div class="info-card" id="allFilesCard">
          <div class="header">
            <span class="icon">📂</span>
            <h3>Allow access to files</h3>
          </div>
          <p>CleanForge needs All-files access to list and delete things in shared storage. It only deletes items you select and confirm, and the app has no internet permission.</p>
          <div class="actions">
            <button class="btn btn-tonal btn-sm" onclick="openAllFilesSettings()">Open settings</button>
          </div>
        </div>

        <!-- Shizuku Card -->
        <div class="info-card" id="shizukuCard">
          <div class="header">
            <span class="icon">⚡</span>
            <h3>Shizuku is optional</h3>
          </div>
          <p>Without it, Android 11+ hides other apps' cache folders (Android/data), so those cleaners are switched off. Everything else works. Install and start Shizuku, then come back.</p>
          <div class="actions">
            <button class="btn btn-outlined btn-sm" onclick="checkShizuku()">Check again</button>
          </div>
        </div>

        <!-- Scan Bar -->
        <div class="scan-bar">
          <div class="label">Looks at app caches, thumbnails, abandoned downloads, installers and leftovers of uninstalled apps. Nothing is deleted until you review and confirm.</div>
          <div class="actions">
            <button class="btn btn-filled btn-sm" id="scanBtn" onclick="startScan('quick')">Scan</button>
          </div>
        </div>

        <!-- Notices -->
        <div id="cleanNotices"></div>

        <!-- Results -->
        <div id="cleanResults"></div>
      </div>

      <!-- Review Screen -->
      <div class="screen" id="screen-review">
        <div class="card card-tertiary" style="margin-top:8px;">
          <p style="font-size:14px;line-height:1.5;">These tools only suggest things for YOU to look at. Large, old or duplicated files are often exactly what you want to keep, so none of them are ticked for you.</p>
        </div>

        <div class="scan-bar">
          <div class="label">Duplicate detection reads file contents on this phone (nothing is uploaded) and can take a few minutes on a lot of photos or videos.</div>
          <div class="actions">
            <button class="btn btn-filled btn-sm" id="reviewScanBtn" onclick="startScan('ondemand')">Find large files, duplicates, logs, empty folders</button>
          </div>
        </div>

        <div id="reviewNotices"></div>
        <div id="reviewResults"></div>
      </div>

      <!-- Memory Screen -->
      <div class="screen" id="screen-ram">
        <div class="ram-container">
          <div class="ram-gauge" id="ramGauge">
            <svg viewBox="0 0 160 160">
              <circle cx="80" cy="80" r="70" fill="none" stroke="var(--surface-container-highest)" stroke-width="12"/>
              <circle cx="80" cy="80" r="70" fill="none" stroke="var(--primary)" stroke-width="12"
                stroke-dasharray="440" stroke-dashoffset="220" stroke-linecap="round" id="ramRing"/>
            </svg>
            <div class="label">
              <span class="pct" id="ramPct">50%</span>
              <span class="sub" id="ramPressure">MODERATE</span>
            </div>
          </div>
          <div class="ram-stats">
            <div class="used" id="ramUsed">3.2 GB used of 6.0 GB</div>
            <div class="avail" id="ramAvail">2.8 GB available</div>
          </div>
          <button class="btn btn-filled" id="clearRamBtn" onclick="clearRam()">Clear background apps</button>
          <div id="ramResult" style="font-size:13px;color:var(--on-surface-variant);text-align:center;"></div>
          <div class="ram-explainer">
            <strong>Honest memory info.</strong> CleanForge reads <code>/proc/meminfo</code> directly — no fake "boost" claims. Clearing background apps may free some RAM, but Android will reload them when needed, which uses more battery. The number above is the actual freed bytes, never an estimate.
          </div>
        </div>
      </div>

      <!-- About Screen -->
      <div class="screen" id="screen-about">
        <div class="card card-primary" style="margin-top:8px;">
          <div class="about-header">
            <div class="about-icon">🧹</div>
            <div>
              <h2>CleanForge</h2>
              <div class="sub">Made by Aman</div>
              <div class="meta">Version 1.0.0 · © 2026 Aman · free and open source</div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="fact-row">
            <span class="icon">📶</span>
            <div class="text">
              <h4>No internet, no tracking</h4>
              <p>CleanForge does not declare the INTERNET permission. There are no ads, no analytics, and no accounts. Your files never leave your phone.</p>
            </div>
          </div>
          <div class="fact-row">
            <span class="icon">🔒</span>
            <div class="text">
              <h4>Evidence-based cleaning</h4>
              <p>Every item flagged carries proof of why it's safe to delete. Filename or extension alone is never accepted as evidence. You review and confirm everything.</p>
            </div>
          </div>
          <div class="fact-row">
            <span class="icon">🛡️</span>
            <div class="text">
              <h4>Safety first</h4>
              <p>Fingerprint verification, symlink protection, mount boundaries, and depth limits. No shell commands, no recursive deletion. Personal data zones are never pre-selected.</p>
            </div>
          </div>
          <div class="fact-row">
            <span class="icon">⚡</span>
            <div class="text">
              <h4>Shizuku integration (optional)</h4>
              <p>On Android 11+, Android/data and Android/obb are invisible to normal apps. Shizuku (user-service, not root) lets CleanForge read and clear those caches. Without it, those scanners are skipped with a visible notice.</p>
            </div>
          </div>
          <div class="fact-row">
            <span class="icon">🧠</span>
