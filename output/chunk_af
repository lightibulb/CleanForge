                Spacer(Modifier.height(22.dp))
                val breakdown = storage.breakdown
                when {
                    breakdown == null && storage.loading ->
                        Text("Measuring…", style = MaterialTheme.typography.bodyMedium, color = palette.ink3)
                    breakdown == null -> {
