                        contentDescription = item.label,
                        tint = tint,
                        modifier = Modifier
                            .size(20.dp)
                            .graphicsLayer { scaleX = iconScale; scaleY = iconScale },
                    )
                    Spacer(Modifier.height(2.dp))
                    Text(
                        text = item.label,
                        style = androidx.compose.material3.MaterialTheme.typography.labelSmall,
                        fontWeight = FontWeight.Medium,
                        color = tint,
                    )
                }
            }
        }
    }
