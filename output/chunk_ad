+    ) : Scanner {
+        override val displayName: String = "Scanner $id"
+        override val mode: ScanMode = ScanMode.QUICK
+        override fun scan(): Flow<List<ScanItem>> = flow {
+            failWith?.let { throw it }
+            emit(items)
+        }
+
