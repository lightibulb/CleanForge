+    CapabilityStatus.NEEDS_AUTHORIZATION -> "Needs permission"
+    CapabilityStatus.UNAVAILABLE -> "Unavailable right now"
+    CapabilityStatus.UNSUPPORTED -> "Not supported on this device"
+    CapabilityStatus.UNKNOWN -> "Not checked"
